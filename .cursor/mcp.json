{
  "mcpServers": {
    "harborline": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "harborline.mcp_server"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "HARBORLINE_RETRIEVE_BACKEND": "openai",
        "PYTHONUNBUFFERED": "1"
      }
    },
    "harborline-http": {
      "url": "http://127.0.0.1:18765/mcp/"
    }
  }
}
